# Set once you have a domain. Vercel injects its own production URL as a
# fallback, so this is only needed for a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense. Leave these unset and no ad code loads at all —
# no script request, no empty boxes. Fill them in after approval.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_AD_SLOT_ARTICLE=0000000000
NEXT_PUBLIC_AD_SLOT_RAIL=0000000000
